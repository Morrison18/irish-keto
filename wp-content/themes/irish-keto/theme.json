{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1100px"
		},
		"color": {
			"palette": [
				{ "slug": "background", "name": "Background (white)", "color": "#ffffff" },
				{ "slug": "foreground", "name": "Foreground (black)", "color": "#161616" },
				{ "slug": "primary", "name": "Primary (block red)", "color": "#a6192e" },
				{ "slug": "accent", "name": "Accent (black)", "color": "#161616" },
				{ "slug": "gold", "name": "Deep red (hover/shadow)", "color": "#7a0f1f" },
				{ "slug": "muted", "name": "Muted (light grey)", "color": "#ececec" },
				{ "slug": "card", "name": "Card surface", "color": "#ffffff" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Fraunces",
					"fontFamily": "'Fraunces', ui-serif, Georgia, serif"
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "'Inter', ui-sans-serif, system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.75rem" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "2px"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "disclaimer", "title": "Dietary Disclaimer", "area": "uncategorized" }
	]
}
